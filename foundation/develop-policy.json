{
  "schema_version": 1,
  "purpose": "Limits and extra protected paths of the ante develop loop. This file protects itself: a proposal that touches it is refused, and the gate reads it from the base revision.",
  "max_open_proposals": 1,
  "campaign_spend_usd": 50,
  "consecutive_regressions_to_stop": 2,
  "editable_scopes": [
    "academic/**",
    "design/**",
    "engineering/**",
    "finance/**",
    "game-development/**",
    "gis/**",
    "healthcare/**",
    "marketing/**",
    "mispriced-cmo/**",
    "paid-media/**",
    "product/**",
    "project-management/**",
    "research/**",
    "sales/**",
    "security/**",
    "spatial-computing/**",
    "specialized/**",
    "support/**",
    "testing/**",
    "strategy/vectors.json",
    "ante/nexus/**",
    "ante/registry/**"
  ],
  "protected": [
    "foundation/develop-policy.json",
    "foundation/DECISIONS.md",
    "ante/develop/**",
    "ante/turing/**",
    "ante/ice/**",
    "ante/constructs/**",
    "ante/core/**",
    "ante/doctrine/**",
    "ante/learn/**",
    "ante/_compat.py",
    "ante/paths.py",
    "ante/strategy/**",
    "ante/attest/**",
    "foundation/attest/**",
    "ante/cli.py",
    "ante/deck.py",
    "ante/__init__.py",
    "ante/__main__.py",
    "tests/**",
    "strategy/*.md",
    "strategy/challenger-pairs.json",
    "strategy/contracts.json",
    "strategy/overdrive-protected.json",
    "strategy/providers.json",
    "strategy/runbooks.json",
    "strategy/unified-agency-sources.json",
    "scripts/**",
    ".github/**"
  ],
  "finding_min_sample": 30,
  "pattern_semantics": "fnmatch, as in nexus-improve.py: \"*\" also matches \"/\", so \"strategy/*.md\" covers every Markdown file under strategy/."
}
